{
  "name": "tuhitu-adopt-an-elder-functional",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "powershell -NoProfile -Command \"$env:WRANGLER_LOG_PATH='.wrangler/wrangler.log'; & '.\\node_modules\\.bin\\vite.cmd'\"",
    "build": "powershell -NoProfile -Command \"& '.\\node_modules\\.bin\\vinext.cmd' build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/validate-artifact.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/export-netlify-static.mjs\"",
    "start": "powershell -NoProfile -Command \"$env:WRANGLER_LOG_PATH='.wrangler/wrangler.log'; & '.\\node_modules\\.bin\\vinext.cmd' start\"",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "powershell -NoProfile -Command \"& '.\\node_modules\\.bin\\eslint.cmd' '.' '--ignore-pattern' 'dist' '--ignore-pattern' '.next'\"",
    "db:generate": "powershell -NoProfile -Command \"& '.\\node_modules\\.bin\\drizzle-kit.cmd' generate\""
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "TuHiTu Adopt an Elder"
}
